generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  CLOSED
  EXPIRED
  REVOKED
  ARCHIVED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AuditActorType {
  USER
  BOT
  SYSTEM
}

enum AdminLevel {
  SUPER_ADMIN
  SENIOR_ADMIN
  ADMIN
  HELPER
}

enum RoleMappingKind {
  ADMIN_LEVEL
  FACTION_MEMBER
  FACTION_LEADER
  FACTION_DEPUTY
  DEPARTMENT
  RANK
  PERMISSION
}

enum RegistrationKind {
  VEHICLE
  UNIFORM
}

enum DecisionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

enum WebhookRequestStatus {
  PENDING
  FORM_BUILT
  CLOSED
  REJECTED
}

enum FeedbackTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id            String     @id @default(cuid())
  discordId     String     @unique @map("discord_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  auditEvents   AuditLog[] @relation("AuditActor")
  initiatedJobs Job[]      @relation("JobInitiator")
  characters    Character[]

  @@map("users")
}

model Guild {
  id           String           @id @default(cuid())
  discordId    String           @unique @map("discord_id")
  name         String
  iconUrl      String?          @map("icon_url")
  status       RecordStatus     @default(ACTIVE)
  settings     Json             @default("{}")
  lastSyncedAt DateTime?        @map("last_synced_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  factions     Faction[]
  roles        DiscordRole[]
  channels     DiscordChannel[]
  members      GuildMember[]
  roleMappings RoleMapping[]

  @@map("guilds")
}

/// Text-capable guild channels synced from Discord for dashboard pickers.
model DiscordChannel {
  id        String       @id @default(cuid())
  discordId String       @unique @map("discord_id")
  guildId   String       @map("guild_id")
  guild     Guild        @relation(fields: [guildId], references: [id])
  name      String
  /// Discord channel type enum value (0 = GuildText, 5 = GuildAnnouncement, …)
  type      Int          @default(0)
  position  Int          @default(0)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([guildId, status])
  @@map("discord_channels")
}

model DiscordRole {
  id        String       @id @default(cuid())
  discordId String       @unique @map("discord_id")
  guildId   String       @map("guild_id")
  guild     Guild        @relation(fields: [guildId], references: [id])
  name      String
  color     Int          @default(0)
  position  Int          @default(0)
  managed   Boolean      @default(false)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([guildId])
  @@map("discord_roles")
}

model GuildMember {
  id             String    @id @default(cuid())
  guildId        String    @map("guild_id")
  guild          Guild     @relation(fields: [guildId], references: [id])
  userDiscordId  String    @map("user_discord_id")
  username       String
  globalName     String?   @map("global_name")
  nickname       String?
  avatarUrl      String?   @map("avatar_url")
  guildAvatarUrl String?   @map("guild_avatar_url")
  roleIds        String[]  @map("role_ids")
  joinedAt       DateTime? @map("joined_at")
  isPresent      Boolean   @default(true) @map("is_present")
  leftAt         DateTime? @map("left_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([guildId, userDiscordId])
  @@index([userDiscordId])
  @@map("discord_guild_members")
}

model RoleMapping {
  id            String          @id @default(cuid())
  guildId       String          @map("guild_id")
  guild         Guild           @relation(fields: [guildId], references: [id])
  roleDiscordId String          @map("role_discord_id")
  kind          RoleMappingKind
  value         String          @default("")
  factionId     String?         @map("faction_id")
  faction       Faction?        @relation(fields: [factionId], references: [id])
  status        RecordStatus    @default(ACTIVE)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([roleDiscordId, kind, value])
  @@index([guildId])
  @@index([status])
  @@map("role_mappings")
}

model Faction {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  color        String?
  emoji        String?
  sortOrder    Int           @default(0) @map("sort_order")
  status       RecordStatus  @default(ACTIVE)
  guildId      String?       @map("guild_id")
  guild        Guild?        @relation(fields: [guildId], references: [id])
  settings     Json          @default("{}")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  roleMappings RoleMapping[]

  @@index([guildId])
  @@map("factions")
}

model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AuditLog {
  id          String         @id @default(cuid())
  actorType   AuditActorType @map("actor_type")
  actorUserId String?        @map("actor_user_id")
  actorUser   User?          @relation("AuditActor", fields: [actorUserId], references: [id])
  action      String
  entityType  String         @map("entity_type")
  entityId    String         @map("entity_id")
  source      String
  ipAddress   String?        @map("ip_address")
  guildId     String?        @map("guild_id")
  channelId   String?        @map("channel_id")
  before      Json?
  after       Json?
  metadata    Json           @default("{}")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

model Job {
  id            String    @id @default(cuid())
  type          String
  payload       Json
  status        JobStatus @default(PENDING)
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5) @map("max_attempts")
  availableAt   DateTime  @default(now()) @map("available_at")
  lockedAt      DateTime? @map("locked_at")
  lockedBy      String?   @map("locked_by")
  completedAt   DateTime? @map("completed_at")
  lastError     String?   @map("last_error")
  result        Json?
  initiatedById String?   @map("initiated_by_id")
  initiatedBy   User?     @relation("JobInitiator", fields: [initiatedById], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([status, lockedAt])
  @@map("jobs")
}

model AuditLogArchive {
  id         String   @id
  payload    Json
  archivedAt DateTime @default(now()) @map("archived_at")

  @@map("audit_log_archive")
}

// ──────────────────────────────────────────────────────────────
// Embed manager & button engine
// ──────────────────────────────────────────────────────────────

/// Saved embed / Components V2 design template.
model MessageDesign {
  id           String        @id @default(cuid())
  name         String
  description  String?
  /// Full EmbedSpec JSON: { version, embeds } or { version:2, components }
  spec         Json
  status       RecordStatus  @default(ACTIVE)
  createdById  String?       @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  sentMessages SentMessage[] @relation("DesignMessages")

  @@map("message_designs")
}

/// Record of a message actually sent to Discord by the bot.
model SentMessage {
  id               String           @id @default(cuid())
  guildDiscordId   String           @map("guild_discord_id")
  channelDiscordId String           @map("channel_discord_id")
  messageDiscordId String           @map("message_discord_id")
  designId         String?          @map("design_id")
  design           MessageDesign?   @relation("DesignMessages", fields: [designId], references: [id])
  /// Snapshot of the spec at send time (may differ from design after edits).
  spec             Json
  status           RecordStatus     @default(ACTIVE)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  links            SentMessageLink[]

  @@unique([channelDiscordId, messageDiscordId])
  @@index([guildDiscordId])
  @@map("sent_messages")
}

/// Persistent button action: custom_id = "mirror:<action>:<id>".
/// Keeps working after bot restarts because params live in the DB.
model ButtonAction {
  id        String       @id @default(cuid())
  /// Action identifier, e.g. "wanted.close", "role.toggle".
  action    String
  params    Json         @default("{}")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([action, status])
  @@map("button_actions")
}

// ──────────────────────────────────────────────────────────────
// Documents
// ──────────────────────────────────────────────────────────────

model Document {
  id              String             @id @default(cuid())
  number          String             @unique
  factionCode     String             @map("faction_code")
  authorDiscordId String             @map("author_discord_id")
  subject         String
  content         String
  /// Уведомляемое лицо (legacy /пост)
  notifiedPerson  String             @map("notified_person")
  /// Ссылка на форум (spoiler in Discord embed)
  forumLink       String             @map("forum_link")
  /// Ответственный лидер
  leaderText      String             @map("leader_text")
  /// Ответственный зам
  deputyText      String             @map("deputy_text")
  status          RecordStatus       @default(ACTIVE)
  expiresAt       DateTime?          @map("expires_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  sentMessages    SentMessageLink[]  @relation("DocumentMessages")
  responses       DocumentResponse[]

  @@index([factionCode, status])
  @@index([authorDiscordId])
  @@map("documents")
}

model DocumentResponse {
  id              String           @id @default(cuid())
  documentId      String           @map("document_id")
  document        Document         @relation(fields: [documentId], references: [id])
  authorDiscordId String           @map("author_discord_id")
  /// Личное дело (legacy /ответ)
  personalFile    String           @map("personal_file")
  /// Видеофиксация
  video           String
  /// Комментарий (legacy field; stored as content historically)
  content         String
  status          RecordStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  sentMessages    SentMessageLink[] @relation("ResponseMessages")

  @@index([documentId])
  @@map("document_responses")
}

// ──────────────────────────────────────────────────────────────
// Federal wanted
// ──────────────────────────────────────────────────────────────

model Wanted {
  id                String            @id @default(cuid())
  number            String            @unique
  /// Passport / static id (legacy «паспорт»).
  staticId          String            @map("static_id")
  characterName     String            @map("character_name")
  /// Charges / article (legacy «статья»).
  reason            String
  termText          String            @map("term_text")
  forumLink         String            @map("forum_link")
  issuedByDiscordId String            @map("issued_by_discord_id")
  closedByDiscordId String?           @map("closed_by_discord_id")
  evidence          String?
  status            RecordStatus      @default(ACTIVE)
  expiresAt         DateTime?         @map("expires_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  sentMessages      SentMessageLink[] @relation("WantedMessages")

  @@index([staticId])
  @@index([status])
  @@map("wanteds")
}

// ──────────────────────────────────────────────────────────────
// Fines
// ──────────────────────────────────────────────────────────────

model Fine {
  id                   String            @id @default(cuid())
  number               String            @unique
  /// Passport / static id (legacy «паспорт»).
  staticId             String            @map("static_id")
  characterName        String            @map("character_name")
  amount               Int
  /// Article / basis (legacy «статья»).
  reason               String
  issuedByDiscordId    String            @map("issued_by_discord_id")
  factionCode          String            @map("faction_code")
  /// Human-readable deadline as entered (e.g. «24h»).
  paymentDeadlineText  String            @map("payment_deadline_text")
  paidAt               DateTime?         @map("paid_at")
  paidByDiscordId      String?           @map("paid_by_discord_id")
  overdueNotified      Boolean           @default(false) @map("overdue_notified")
  status               RecordStatus      @default(ACTIVE)
  dueAt                DateTime?         @map("due_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  sentMessages         SentMessageLink[] @relation("FineMessages")

  @@index([staticId])
  @@index([status])
  @@index([factionCode])
  @@map("fines")
}

// ──────────────────────────────────────────────────────────────
// Personnel events (кадровый аудит)
// ──────────────────────────────────────────────────────────────

/// Type values: promotion | dismissal | transfer | reinstatement | appointment
model PersonnelEvent {
  id               String           @id @default(cuid())
  factionCode      String           @map("faction_code")
  type             String
  subjectDiscordId String           @map("subject_discord_id")
  subjectName      String           @map("subject_name")
  actorDiscordId   String           @map("actor_discord_id")
  details          Json             @default("{}")
  status           RecordStatus     @default(ACTIVE)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  sentMessages     SentMessageLink[] @relation("PersonnelMessages")

  @@index([factionCode])
  @@index([subjectDiscordId])
  @@map("personnel_events")
}

// ──────────────────────────────────────────────────────────────
// Polymorphic link: sent_messages ↔ module entities
// (avoids nullable FK explosion on SentMessage)
// ──────────────────────────────────────────────────────────────

model SentMessageLink {
  id              String          @id @default(cuid())
  sentMessageId   String          @map("sent_message_id")
  sentMessage     SentMessage     @relation(fields: [sentMessageId], references: [id])
  documentId      String?         @map("document_id")
  document        Document?       @relation("DocumentMessages", fields: [documentId], references: [id])
  responseId      String?         @map("response_id")
  response        DocumentResponse? @relation("ResponseMessages", fields: [responseId], references: [id])
  wantedId        String?         @map("wanted_id")
  wanted          Wanted?         @relation("WantedMessages", fields: [wantedId], references: [id])
  fineId          String?         @map("fine_id")
  fine            Fine?           @relation("FineMessages", fields: [fineId], references: [id])
  personnelId     String?         @map("personnel_id")
  personnelEvent  PersonnelEvent? @relation("PersonnelMessages", fields: [personnelId], references: [id])
  icBlacklistId   String?         @map("ic_blacklist_id")
  icBlacklist     IcBlacklistEntry? @relation("IcBlacklistMessages", fields: [icBlacklistId], references: [id])
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([sentMessageId])
  @@index([icBlacklistId])
  @@map("sent_message_links")
}

// ──────────────────────────────────────────────────────────────
// Stage 4: characters, tokens and registrations
// ──────────────────────────────────────────────────────────────

model Character {
  id              String           @id @default(cuid())
  userId          String           @map("user_id")
  user            User             @relation(fields: [userId], references: [id])
  slot            Int
  /// Unique among ACTIVE characters only (partial index `characters_static_id_active_key` in SQL).
  staticId        String           @map("static_id")
  name            String
  factionCode     String?          @map("faction_code")
  department      String?
  rank            Int?
  status          RecordStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  tokens          Token[]
  registrations   Registration[]
  outgoingTransfers Transfer[]     @relation("TransferCharacter")

  /// (user_id, slot) is unique among ACTIVE characters only (partial index in SQL).
  @@index([staticId])
  @@index([userId, status])
  @@index([factionCode, status])
  @@map("characters")
}

model Token {
  id              String       @id @default(cuid())
  number          String       @unique
  /// One ACTIVE token per character (partial index `tokens_character_id_active_key` in SQL).
  characterId     String       @map("character_id")
  character       Character    @relation(fields: [characterId], references: [id])
  status          RecordStatus @default(ACTIVE)
  issuedAt        DateTime     @default(now()) @map("issued_at")
  revokedAt       DateTime?    @map("revoked_at")
  revokedById     String?      @map("revoked_by_id")

  @@index([characterId, status])
  @@index([status])
  @@map("tokens")
}

model Registration {
  id                 String           @id @default(cuid())
  kind               RegistrationKind
  /// Optional legacy link; vehicle/uniform registration does not require a Character/token.
  characterId        String?          @map("character_id")
  character          Character?       @relation(fields: [characterId], references: [id])
  /// Free-text static from the application (not looked up against characters/tokens).
  staticId           String           @map("static_id")
  applicantDiscordId String           @map("applicant_discord_id")
  payload            Json
  /// Normalized plate for VEHICLE; unique among ACTIVE vehicle registrations (partial index in SQL).
  plate              String?
  /// media_files ids (photo), never raw URLs.
  evidenceFileIds    String[]         @default([]) @map("evidence_file_ids")
  status             RecordStatus     @default(ACTIVE)
  decision           DecisionStatus   @default(PENDING)
  decidedByDiscordId String?          @map("decided_by_discord_id")
  rejectionReason    String?          @map("rejection_reason")
  decidedAt          DateTime?        @map("decided_at")
  expiresAt          DateTime?        @map("expires_at")
  reviewGuildId      String?          @map("review_guild_id")
  reviewChannelId    String?          @map("review_channel_id")
  reviewMessageId    String?          @map("review_message_id")
  reviewThreadId     String?          @map("review_thread_id")
  /// Button custom ids created at enqueue time: { approve, reject }.
  reviewButtons      Json             @default("{}") @map("review_buttons")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@index([staticId, kind, status])
  @@index([characterId, kind, status])
  @@index([decision, status])
  @@index([status, expiresAt])
  @@index([plate])
  @@map("registrations")
}

/// Reference catalog of vehicle models (§5.3). Does not restrict `/регистрация-тс` (free-text model).
model VehicleModel {
  id          String       @id @default(cuid())
  name        String       @unique
  brand       String?
  year        Int?
  /// media_files id of the card photo, never a raw URL.
  imageFileId String?      @map("image_file_id")
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([status, name])
  @@index([status, brand])
  @@map("vehicle_models")
}

model MediaFile {
  id           String       @id @default(cuid())
  objectKey    String       @unique @map("object_key")
  originalName String       @map("original_name")
  contentType  String       @map("content_type")
  sizeBytes    Int          @map("size_bytes")
  status       RecordStatus @default(ACTIVE)
  createdById  String?      @map("created_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("media_files")
}

// ──────────────────────────────────────────────────────────────
// Stage 4: transfers, webhook requests and IC blacklist
// ──────────────────────────────────────────────────────────────

model Transfer {
  id                    String         @id @default(cuid())
  characterId           String         @map("character_id")
  character             Character      @relation("TransferCharacter", fields: [characterId], references: [id])
  fromFactionCode       String         @map("from_faction_code")
  toFactionCode         String         @map("to_faction_code")
  fromRank               Int           @map("from_rank")
  toRank                 Int           @map("to_rank")
  documentFileIds        String[]      @default([]) @map("document_file_ids")
  sourceDecision         DecisionStatus @default(PENDING) @map("source_decision")
  targetDecision         DecisionStatus @default(PENDING) @map("target_decision")
  status                 TransferStatus @default(PENDING)
  rejectionReason        String?       @map("rejection_reason")
  sourceDecidedByDiscordId String?     @map("source_decided_by_discord_id")
  targetDecidedByDiscordId String?     @map("target_decided_by_discord_id")
  reviewGuildId          String?       @map("review_guild_id")
  reviewChannelId        String?       @map("review_channel_id")
  reviewMessageId        String?       @map("review_message_id")
  /// Button custom ids created at enqueue time: { sourceApprove, sourceReject, targetApprove, targetReject }.
  reviewButtons          Json          @default("{}") @map("review_buttons")
  createdByDiscordId     String        @map("created_by_discord_id")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  @@index([characterId, status])
  @@index([fromFactionCode, status])
  @@index([toFactionCode, status])
  @@map("transfers")
}

/// Rank equivalence for /перевод-фракции (§4.8 / §5.3). Empty pair = free ranks.
model TransferRankRule {
  id              String       @id @default(cuid())
  fromFactionCode String       @map("from_faction_code")
  toFactionCode   String       @map("to_faction_code")
  fromRank        Int          @map("from_rank")
  toRank          Int          @map("to_rank")
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([fromFactionCode, toFactionCode, status])
  @@map("transfer_rank_rules")
}

model WebhookRequest {
  id                 String              @id @default(cuid())
  requesterDiscordId String              @map("requester_discord_id")
  guildDiscordId     String              @map("guild_discord_id")
  channelDiscordId   String              @map("channel_discord_id")
  description        String
  webhookUrl         String?             @map("webhook_url")
  status             WebhookRequestStatus @default(PENDING)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("webhook_requests")
}

/// Government IC blacklist (/чс-гос), analogous to federal wanted.
model IcBlacklistEntry {
  id                 String            @id @default(cuid())
  /// System-generated record number (BL-001 …).
  number             String            @unique
  /// Passport / static id (legacy «паспорт»).
  staticId           String            @map("static_id")
  fullName           String            @map("full_name")
  reason             String
  /// Forum evidence link (legacy «доказательства» / ссылка_на_форум).
  forumLink          String            @map("forum_link")
  expiresAt          DateTime?         @map("expires_at")
  status             RecordStatus      @default(ACTIVE)
  createdByDiscordId String            @map("created_by_discord_id")
  closedByDiscordId  String?           @map("closed_by_discord_id")
  closeReason        String?           @map("close_reason")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  sentMessages       SentMessageLink[] @relation("IcBlacklistMessages")

  @@index([staticId, status])
  @@index([status, expiresAt])
  @@map("ic_blacklist")
}

// ──────────────────────────────────────────────────────────────
// Stage 4: role panels, feedback and Discord forms
// ──────────────────────────────────────────────────────────────

model RolePanel {
  id                 String       @id @default(cuid())
  guildDiscordId     String       @map("guild_discord_id")
  channelDiscordId   String       @map("channel_discord_id")
  messageDiscordId   String?      @map("message_discord_id")
  spec               Json
  status             RecordStatus @default(ACTIVE)
  createdByDiscordId String       @map("created_by_discord_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@index([guildDiscordId, channelDiscordId, status])
  @@map("role_panels")
}

model FeedbackTicket {
  id                 String               @id @default(cuid())
  authorDiscordId    String               @map("author_discord_id")
  category           String
  status             FeedbackTicketStatus @default(OPEN)
  assignedToDiscordId String?             @map("assigned_to_discord_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  messages           FeedbackMessage[]

  @@index([status, createdAt])
  @@index([authorDiscordId])
  @@map("feedback_tickets")
}

model FeedbackMessage {
  id               String         @id @default(cuid())
  ticketId         String         @map("ticket_id")
  ticket           FeedbackTicket @relation(fields: [ticketId], references: [id])
  authorDiscordId  String         @map("author_discord_id")
  content          String
  attachmentFileIds String[]      @default([]) @map("attachment_file_ids")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("feedback_messages")
}

model DiscordForm {
  id                   String       @id @default(cuid())
  name                 String
  description          String?
  webhookUrl           String?      @map("webhook_url")
  deliveryChannelId    String?      @map("delivery_channel_id")
  /// Last published message with a form.open button (Discord message link).
  openGuildDiscordId   String?      @map("open_guild_discord_id")
  openChannelDiscordId String?      @map("open_channel_discord_id")
  openMessageDiscordId String?      @map("open_message_discord_id")
  status               RecordStatus @default(ACTIVE)
  expiresAt            DateTime?    @map("expires_at")
  responseLimit        Int?         @map("response_limit")
  createdByDiscordId   String       @map("created_by_discord_id")
  /// Public page address `/f/<slug>`; null until the form is published on the web.
  slug                 String?      @unique
  publicEnabled        Boolean      @default(false) @map("public_enabled")
  successMessage       String?      @map("success_message")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  fields               FormField[]
  submissions          FormSubmission[]
  drafts               FormDraft[]

  @@index([status, expiresAt])
  @@index([webhookUrl])
  @@map("forms")
}

model FormField {
  id          String       @id @default(cuid())
  formId      String       @map("form_id")
  form        DiscordForm  @relation(fields: [formId], references: [id])
  position    Int
  key         String
  label       String
  /// short | paragraph | number | select | multiselect | checkbox | date
  type        String
  required    Boolean      @default(false)
  /// { minLength, maxLength, min, max } depending on the type.
  validation  Json         @default("{}")
  /// Choices for select / multiselect.
  options     Json         @default("[]")
  helpText    String?      @map("help_text")
  /// Removed fields are archived so old submissions keep their labels.
  status      RecordStatus @default(ACTIVE)

  @@unique([formId, key])
  @@index([formId, status, position])
  @@map("form_fields")
}

model FormSubmission {
  id              String      @id @default(cuid())
  formId          String      @map("form_id")
  form            DiscordForm @relation(fields: [formId], references: [id])
  authorDiscordId String?     @map("author_discord_id")
  /// discord | web
  source          String      @default("discord")
  values          Json
  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([formId, createdAt])
  @@map("form_submissions")
}

/// Partial answers of a multi-step Discord form (more than 5 fields); transient working state.
model FormDraft {
  id              String      @id @default(cuid())
  formId          String      @map("form_id")
  form            DiscordForm @relation(fields: [formId], references: [id])
  authorDiscordId String      @map("author_discord_id")
  values          Json        @default("{}")
  /// Index of the next step to show.
  step            Int         @default(0)
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@unique([formId, authorDiscordId])
  @@map("form_drafts")
}

model FaqSection {
  id        String       @id @default(cuid())
  title     String
  position  Int          @default(0)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  items     FaqItem[]

  @@index([status, position])
  @@map("faq_sections")
}

model FaqItem {
  id                 String       @id @default(cuid())
  sectionId          String       @map("section_id")
  section            FaqSection   @relation(fields: [sectionId], references: [id])
  title              String
  /// Markdown.
  body               String
  position           Int          @default(0)
  status             RecordStatus @default(ACTIVE)
  updatedByDiscordId String?      @map("updated_by_discord_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@index([sectionId, status, position])
  @@map("faq_items")
}

/// Public «share» link to a registry record (§5.8). Revoked links answer 404.
model ShareLink {
  id                 String       @id @default(cuid())
  token              String       @unique
  /// wanted | ic_blacklist | fine | document | registration
  entityType         String       @map("entity_type")
  entityId           String       @map("entity_id")
  status             RecordStatus @default(ACTIVE)
  createdByDiscordId String       @map("created_by_discord_id")
  revokedByDiscordId String?      @map("revoked_by_discord_id")
  revokedAt          DateTime?    @map("revoked_at")
  createdAt          DateTime     @default(now()) @map("created_at")

  @@index([entityType, entityId, status])
  @@map("share_links")
}

/// Technical ban (§6): forbids using the bot and the dashboard. Not the IC blacklist.
/// One ACTIVE ban per (kind, value) — partial index in SQL.
model TechBan {
  id                 String       @id @default(cuid())
  /// DISCORD — a Discord account id; STATIC — a character static.
  kind               String
  value              String
  reason             String
  status             RecordStatus @default(ACTIVE)
  createdByDiscordId String       @map("created_by_discord_id")
  revokedByDiscordId String?      @map("revoked_by_discord_id")
  revokedAt          DateTime?    @map("revoked_at")
  createdAt          DateTime     @default(now()) @map("created_at")

  @@index([kind, value, status])
  @@map("tech_bans")
}

/// One dashboard sign-in. The row is both the live session and the login history entry.
model UserSession {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  discordId          String    @map("discord_id")
  ipAddress          String?   @map("ip_address")
  userAgent          String?   @map("user_agent")
  createdAt          DateTime  @default(now()) @map("created_at")
  lastSeenAt         DateTime  @default(now()) @map("last_seen_at")
  /// Set when the session is ended: by its owner, by a super admin, or on sign-out.
  revokedAt          DateTime? @map("revoked_at")
  revokedByDiscordId String?   @map("revoked_by_discord_id")

  @@index([userId, revokedAt])
  @@index([discordId, createdAt])
  @@index([createdAt])
  @@map("sessions")
}

/// A request to grant or remove admin roles on every connected guild (§4.12), with the per-guild report.
model AdminRoleOperation {
  id                   String      @id @default(cuid())
  targetDiscordId      String      @map("target_discord_id")
  /// Level to grant; null removes every admin role.
  level                AdminLevel?
  /// PENDING | DONE | FAILED
  status               String      @default("PENDING")
  /// [{ guildDiscordId, guildName, outcome, added, removed, detail }]
  report               Json        @default("[]")
  requestedByDiscordId String      @map("requested_by_discord_id")
  createdAt            DateTime    @default(now()) @map("created_at")
  completedAt          DateTime?   @map("completed_at")

  @@index([targetDiscordId, createdAt])
  @@index([createdAt])
  @@map("admin_role_operations")
}

/// Last sign of life of a background service (the bot). Read by the status page and the down alert.
model ServiceHeartbeat {
  service String   @id
  at      DateTime
  meta    Json     @default("{}")

  @@map("service_heartbeats")
}
