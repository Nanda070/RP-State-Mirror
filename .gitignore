# Secrets (keep .env.example tracked; .env.legacy matches .env.*)
.env
.env.*
!.env.example

# Dependencies
node_modules/
.pnpm-store/

# Build / toolchain output (pnpm monorepo: apps/*/dist, packages/*/dist, Next.js)
dist/
.next/
.next-check/
out/
.turbo/
*.tsbuildinfo
coverage/
.vercel/

# Local deploy / sync markers
.deploy-previous-commit

# Logs (bot/dashboard detached runs, pnpm/npm debug)
*.log
*.log.err
.bot-detached.err
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Legacy (former Python/SQLite bot)
*.sqlite3
__pycache__/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Editor (do not ignore .claude/ - launch.json is tracked tooling)
.idea/
