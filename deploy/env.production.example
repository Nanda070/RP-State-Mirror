# Production environment of Mirror. setup.sh copies this file to <APP_ROOT>/.env and fills the
# generated values (__GENERATED__) and the address (__DOMAIN__) itself.
# You fill the four Discord values and SUPER_ADMIN_USER_IDS, then run: sudo bash deploy/update.sh start
#
# Secrets and bootstrap access only: everything else is configured in the dashboard.

APP_ENV=production
LOG_LEVEL=info

# --- Discord (https://discord.com/developers/applications) ---
# Bot → Token
DISCORD_BOT_TOKEN=
# OAuth2 → Client ID / Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord user ids of the main administrators, comma separated. They always get in.
SUPER_ADMIN_USER_IDS=

# --- Address of the site (changed by deploy/set-domain.sh) ---
PUBLIC_BASE_URL=https://__DOMAIN__
# Must be listed in Discord → OAuth2 → Redirects exactly as written here.
OAUTH_REDIRECT_URL=https://__DOMAIN__/api/auth/callback/discord

# --- Generated by setup.sh; do not change after the first start ---
SESSION_SECRET=__GENERATED__
POSTGRES_PASSWORD=__GENERATED__
DATABASE_URL=postgresql://mirror:__GENERATED__@127.0.0.1:5432/mirror

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=mirror
S3_ACCESS_KEY=mirror
S3_SECRET_KEY=__GENERATED__

# --- Backups (deploy/backup) ---
BACKUP_AT=04:00
BACKUP_KEEP_DAYS=14

# Legal pages (/terms, /privacy): who operates the service and how to reach them.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
# A phrase, e.g.: законодательство Российской Федерации
LEGAL_GOVERNING_LAW=
