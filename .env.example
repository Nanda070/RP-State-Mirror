# Secrets and bootstrap access only. Everything else is configured in the dashboard.
# Local defaults below match docker-compose.yml; production values come from the host.

APP_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql://mirror:mirror_local_password@localhost:5432/mirror

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:3000/api/auth/callback/discord
SESSION_SECRET=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=mirror_local
S3_SECRET_KEY=mirror_local_password
S3_BUCKET=mirror

SUPER_ADMIN_USER_IDS=1219803151180370021
