{
  "name": "mirror",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r typecheck && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "pnpm --filter @mirror/db prisma:generate",
    "db:validate": "pnpm --filter @mirror/db prisma:validate",
    "db:migrate": "pnpm --filter @mirror/db prisma:migrate",
    "db:deploy": "pnpm --filter @mirror/db prisma:deploy",
    "db:status": "pnpm --filter @mirror/db prisma:status",
    "db:studio": "pnpm --filter @mirror/db prisma:studio",
    "db:seed": "pnpm --filter @mirror/core seed",
    "provision:test-discord": "pnpm --filter @mirror/db build && pnpm --filter @mirror/core build && node --env-file-if-exists=.env --experimental-strip-types scripts/provision-test-discord.ts",
    "bot:dev": "pnpm --filter @mirror/bot dev",
    "bot:start": "pnpm --filter @mirror/bot start",
    "dashboard:dev": "pnpm --filter @mirror/dashboard dev",
    "dashboard:build": "pnpm --filter @mirror/dashboard build",
    "dashboard:start": "pnpm --filter @mirror/dashboard start",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.7.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
