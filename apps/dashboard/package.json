{
  "name": "@mirror/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env ./node_modules/next/dist/bin/next dev --port 3000",
    "build": "node --env-file-if-exists=../../.env ./node_modules/next/dist/bin/next build",
    "start": "node --env-file-if-exists=../../.env ./node_modules/next/dist/bin/next start --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@mirror/core": "workspace:*",
    "@mirror/db": "workspace:*",
    "@univerjs/engine-render": "1.0.3",
    "@univerjs/preset-sheets-conditional-formatting": "1.0.3",
    "@univerjs/preset-sheets-core": "1.0.3",
    "@univerjs/preset-sheets-data-validation": "1.0.3",
    "@univerjs/preset-sheets-drawing": "1.0.3",
    "@univerjs/preset-sheets-filter": "1.0.3",
    "@univerjs/preset-sheets-find-replace": "1.0.3",
    "@univerjs/preset-sheets-sort": "1.0.3",
    "@univerjs/presets": "1.0.3",
    "framer-motion": "^13.5.0",
    "next": "^15.5.27",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
